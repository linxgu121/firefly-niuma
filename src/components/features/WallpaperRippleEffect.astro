---
import { backgroundWallpaper } from "@/config";

const rippleConfig = backgroundWallpaper.ambientEffects?.rippleRefraction;
---

{rippleConfig?.enabled && (
	<canvas
		id="wallpaper-ripple-canvas"
		class="wallpaper-ripple-canvas"
		aria-hidden="true"
	></canvas>
)}

<script>
	import { backgroundWallpaper } from "@/config";
	import { WallpaperRippleController } from "@/utils/wallpaper-ripple";

	type RippleWindow = Window & {
		__fireflyWallpaperRipple?: WallpaperRippleController;
	};

	const rippleWindow = window as RippleWindow;
	const config = backgroundWallpaper.ambientEffects?.rippleRefraction;
	const canvas = document.querySelector<HTMLCanvasElement>(
		"#wallpaper-ripple-canvas",
	);

	if (config?.enabled && canvas) {
		rippleWindow.__fireflyWallpaperRipple?.destroy();
		try {
			const controller = new WallpaperRippleController(canvas, config);
			rippleWindow.__fireflyWallpaperRipple = controller;
			const start = () => controller.start();
			const requestIdle = (
				window as unknown as {
					requestIdleCallback?: (
						callback: () => void,
						options?: { timeout: number },
					) => number;
				}
			).requestIdleCallback;
			if (requestIdle) {
				requestIdle.call(window, start, { timeout: 1400 });
			} else {
				window.setTimeout(start, 0);
			}
		} catch (error) {
			console.info(
				"[WallpaperRipple] 初始化失败，继续使用静态壁纸。",
				error,
			);
		}
	}
</script>

<style is:global>
	.wallpaper-ripple-canvas {
		position: absolute;
		z-index: 6;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
		transition: opacity 180ms ease;
		contain: strict;
	}

	.wallpaper-ripple-canvas.is-ready {
		opacity: 1;
	}

	html[data-wallpaper-ripple="webgl"]
		#wallpaper-wrapper
		#banner-images-container {
		opacity: 0 !important;
	}

	#wallpaper-wrapper #banner-images-container {
		transition: opacity 180ms ease;
	}

	@media (max-width: 1023px), (prefers-reduced-motion: reduce) {
		.wallpaper-ripple-canvas {
			display: none !important;
		}

		html[data-wallpaper-ripple="webgl"]
			#wallpaper-wrapper
			#banner-images-container {
			opacity: 1 !important;
		}
	}
</style>
