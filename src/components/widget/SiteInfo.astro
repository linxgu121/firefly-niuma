---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

// 本站版本号
const BLOG_VERSION = "miuma v1.1.6";

// 本站基于的开源主题（保留出处，尊重开源原创）
const THEME_REPO = "https://github.com/CuteLeaf/Firefly";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
---

<WidgetLayout
  name={i18n(I18nKey.siteInfo)}
  showTitle={showTitle}
  id="site-info"
  class={className}
  style={style}
>
  <div class="flex flex-col gap-2">
    <div
      class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-100/60 dark:bg-neutral-800/50"
    >
      <div class="flex items-center gap-2.5">
        <div class="text-(--primary) text-lg">
          <Icon is:inline name="mdi:clover" />
        </div>
        <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
          {i18n(I18nKey.siteInfoBlogVersion)}
        </span>
      </div>
      <span
        class="text-xs font-bold text-neutral-900 dark:text-neutral-100 text-right max-w-[55%] truncate"
        title={BLOG_VERSION}
      >
        {BLOG_VERSION}
      </span>
    </div>

    <a
      href={THEME_REPO}
      target="_blank"
      rel="noopener noreferrer"
      class="block text-center text-xs text-neutral-400 dark:text-neutral-500 hover:text-(--primary) transition-colors py-1"
    >
      基于开源主题 Firefly 构建 · 感谢上游 fuwari
    </a>
  </div>
</WidgetLayout>
