---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	/** hero：首页主内容区（居中圆形头像 + 社交图标）；mini：侧边栏紧凑个人卡 */
	variant?: "hero" | "mini";
}

const { style, variant = "mini" } = Astro.props;
const className = Astro.props.class;
const isHero = variant === "hero";
---

<div
	class:list={[isHero ? ["px-6", "py-4"] : ["card-base", "profile-mini"], className]}
	style={style}
>
  {isHero && (
    <a
      aria-label="Go to About Page"
      href={url("/about/")}
      class="group block relative mx-auto mb-3 w-20 h-20 md:w-24 md:h-24
         overflow-hidden rounded-full active:scale-95 transition-transform"
    >
      <div
        class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
          w-full h-full z-50 flex items-center justify-center rounded-full"
      >
        <Icon is:inline
          name="fa7-regular:address-card"
          class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-3xl"
        />
      </div>
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt="Profile Image of the Author"
        class="profile-avatar-image mx-auto w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[350]}
        sizes="350px"
      />
    </a>
  )}

  {!isHero && (
    <div class="profile-mini-avatar relative mx-auto mb-3 block h-18 w-18 overflow-hidden rounded-full" aria-hidden="true">
      <ImageWrapper
        src={profileConfig.avatar || ""}
        alt={`${profileConfig.name} 的头像`}
        class="h-full w-full object-cover"
        widths={[144]}
        sizes="72px"
      />
    </div>
  )}

  <div class:list={["profile-copy", isHero && "px-2"]}>
    <div
      class:list={[
        "profile-name font-bold text-center transition",
        isHero
          ? "text-xl text-white"
          : "text-lg dark:text-neutral-50",
      ]}
    >
      {profileConfig.name}
    </div>
    <div
      class:list={["profile-bio text-center transition", isHero ? "text-white" : "text-neutral-400"]}
    >
      {profileConfig.bio}
    </div>

    <nav class:list={["profile-links flex flex-wrap justify-center", isHero && "mb-1"]} aria-label="个人社交链接">
        {profileConfig.links.map(item => {
          const showName = item.showName;
          const btnClass = showName
            ? "profile-link focus-ring h-10 gap-2 px-3 font-bold"
            : "profile-link focus-ring h-10 w-10";

          if (item.url.startsWith("mailto:")) {
            const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
            return (
              <a
                rel="me"
                aria-label={item.name}
                href="#"
                data-encoded-email={encodedEmail}
                onclick={`(function(){const e=this.getAttribute('data-encoded-email');this.href='mailto:'+atob(e);this.removeAttribute('data-encoded-email');this.removeAttribute('onclick');this.click();return false;}).call(this);`}
                class={btnClass}
                title={item.name}
              >
                <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                {showName && item.name}
              </a>
            );
          }
          const isExternal = item.url.startsWith("http");
          return (
            <a
              rel={isExternal ? "me noopener noreferrer" : "me"}
              aria-label={item.name}
              href={isExternal ? item.url : url(item.url)}
              target={isExternal ? "_blank" : undefined}
              class={btnClass}
              title={item.name}
            >
              <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
              {showName && item.name}
            </a>
          );
        })}
    </nav>
  </div>
</div>

<style>
  .profile-mini {
    position: relative;
    overflow: hidden;
    padding: 1.15rem 1rem 1rem;
  }

  .profile-mini::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4.25rem;
    pointer-events: none;
    background: linear-gradient(135deg, color-mix(in oklab, var(--primary) 24%, transparent), transparent 72%);
  }

  .profile-mini-avatar {
    border: 2px solid color-mix(in oklab, white 74%, var(--primary));
    box-shadow: 0 6px 20px color-mix(in oklab, var(--primary) 26%, transparent);
  }

  .profile-mini-avatar :global(div),
  .profile-mini-avatar :global(picture),
  .profile-mini-avatar :global(img) {
    border-radius: inherit;
  }

  .profile-mini .profile-name {
    margin-bottom: 0.25rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .profile-mini .profile-bio {
    margin-bottom: 0.85rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .profile-links {
    gap: 0.5rem;
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--primary) 18%, var(--line-divider));
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--primary) 7%, transparent);
    color: var(--text-secondary);
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .profile-link:hover,
  .profile-link:focus-visible {
    border-color: color-mix(in oklab, var(--primary) 42%, var(--line-divider));
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
    transform: translateY(-1px);
  }

  .profile-link:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-link {
      transition: none;
    }

    .profile-link:hover,
    .profile-link:focus-visible,
    .profile-link:active {
      transform: none;
    }
  }
</style>
