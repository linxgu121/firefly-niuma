---
import AdvancedSearch from "@components/pages/AdvancedSearch.svelte";
import UtilityEmptyState from "@components/pages/UtilityEmptyState.astro";
import UtilityPageHeader from "@components/pages/UtilityPageHeader.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = i18n(I18nKey.search);
const description = i18n(I18nKey.searchTypeSomething);
---

<MainGridLayout title={title} description={description} hasVisibleH1>
	<div class="utility-page">
		<UtilityPageHeader
			title={title}
			description={description}
			icon="material-symbols:search"
		/>
		<AdvancedSearch client:load />
		<noscript>
			<style>#advanced-search { display: none !important; }</style>
			<section class="utility-panel card-base">
				<UtilityEmptyState
					message={i18n(I18nKey.searchLoadError)}
					icon="material-symbols:error-outline"
				/>
			</section>
		</noscript>
	</div>
</MainGridLayout>
