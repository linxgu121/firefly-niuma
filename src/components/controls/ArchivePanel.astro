---
import UtilityEmptyState from "@components/pages/UtilityEmptyState.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPostsList } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

// 归档列表：全量按年分组，服务端渲染。筛选（?tag=/?category=/?uncategorized）
// 与年份折叠由客户端脚本处理——数据本身在构建期已全部就绪。
const sortedPostsList = await getSortedPostsList();

// 严格按发布时间倒序（不受置顶影响），镜像原 Svelte 版行为
const posts = sortedPostsList
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// 按年份分组
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.published.getFullYear();
	if (!grouped.has(year)) grouped.set(year, []);
	grouped.get(year)?.push(post);
}
const groups = Array.from(grouped.entries())
	.map(([year, yearPosts]) => ({ year, posts: yearPosts }))
	.sort((a, b) => b.year - a.year);

// 初始折叠规则：foldArticle 非 false 且多于一年时，除首年外全部折叠
const foldArticle = siteConfig.foldArticle !== false;
const collapseAllButFirst = foldArticle && groups.length > 1;

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}

// 传给客户端脚本的 i18n 文案与配置
const i18nStrings = {
	categories: i18n(I18nKey.categories),
	tags: i18n(I18nKey.tags),
	uncategorized: i18n(I18nKey.uncategorized),
	postCount: i18n(I18nKey.postCount),
	postsCount: i18n(I18nKey.postsCount),
};
const tagsBaseUrl = url("/tags/");
const categoriesBaseUrl = url("/categories/");
const foldOnFilter = collapseAllButFirst;
---

<archive-panel
	class="archive-panel card-base onload-animation"
	data-fold={foldOnFilter ? "true" : "false"}
>
	<div id="archive-filter-header" class="archive-filter-header" hidden>
		<div class="archive-filter-copy">
			<a id="archive-filter-link" href={tagsBaseUrl}></a>
			<span aria-hidden="true">/</span>
			<strong id="archive-filter-values"></strong>
			<span id="archive-filter-secondary" hidden></span>
		</div>
		<div class="archive-filter-count">
			<span id="archive-filter-count"></span>
			<span id="archive-filter-count-label"></span>
		</div>
	</div>

	<div id="archive-filter-empty" hidden>
		<UtilityEmptyState message={i18n(I18nKey.noData)} icon="material-symbols:search-off" />
	</div>

	{
		groups.length === 0 ? (
			<UtilityEmptyState message={i18n(I18nKey.noData)} />
		) : groups.map((group, groupIndex) => {
			const collapsed = collapseAllButFirst && groupIndex > 0;
			const contentId = `archive-year-${group.year}`;
			return (
				<section class="archive-year-block" data-year={group.year} data-count={group.posts.length}>
					<button
						type="button"
						class="archive-year-toggle"
						aria-expanded={collapsed ? "false" : "true"}
						aria-controls={contentId}
					>
						<span class="archive-year">{group.year}</span>
						<span class="archive-year-marker" aria-hidden="true"></span>
						<span class="archive-year-summary">
							<span class="archive-year-count">{group.posts.length}</span>
							<span class="archive-year-count-label">{i18n(group.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}</span>
						</span>
						<Icon
							is:inline
							name="material-symbols:keyboard-arrow-down-rounded"
							class="archive-arrow"
							style={collapsed ? "transform: rotate(-90deg)" : ""}
						/>
					</button>

					<div id={contentId} class="archive-year-content" hidden={collapsed}>
						{group.posts.map((post) => (
							<a
								href={getPostUrlBySlug(post.id)}
								aria-label={post.data.title}
								class="archive-post"
								data-tags={JSON.stringify(post.data.tags || [])}
								data-category={post.data.category || ""}
							>
								<time datetime={post.data.published.toISOString().slice(0, 10)}>{formatDate(post.data.published)}</time>
								<span class="archive-post-marker" aria-hidden="true"></span>
								<span class="archive-post-copy">
									<span class="archive-post-title">{post.data.title}</span>
									{(post.data.category || post.data.tags.length > 0) && (
										<span class="archive-post-meta">
											{post.data.category && <span>{post.data.category}</span>}
											{post.data.category && post.data.tags.length > 0 && <span aria-hidden="true">/</span>}
											{post.data.tags.length > 0 && <span>{post.data.tags.map((tag) => `#${tag}`).join(" ")}</span>}
										</span>
									)}
								</span>
								<Icon is:inline name="material-symbols:chevron-right-rounded" class="archive-post-chevron" />
							</a>
						))}
					</div>
				</section>
			);
		})
	}
</archive-panel>

<style>
	archive-panel {
		display: block;
		min-width: 0;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	[hidden] {
		display: none !important;
	}

	.archive-filter-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid color-mix(in oklab, var(--primary) 18%, var(--line-divider));
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--primary) 6%, transparent);
		color: var(--text-secondary);
		font-size: 0.82rem;
	}

	.archive-filter-copy {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}

	.archive-filter-copy a:hover,
	.archive-filter-copy a:focus-visible,
	.archive-filter-copy strong {
		color: var(--primary);
	}

	.archive-filter-count {
		display: flex;
		flex: 0 0 auto;
		gap: 0.3rem;
		color: var(--text-tertiary);
	}

	.archive-year-block + .archive-year-block {
		margin-top: 0.3rem;
	}

	.archive-year-toggle,
	.archive-post {
		display: grid;
		width: 100%;
		min-width: 0;
		grid-template-columns: 4.4rem 1.35rem minmax(0, 1fr) 1.5rem;
		align-items: center;
		gap: 0.6rem;
		border-radius: 0.75rem;
		outline: none;
	}

	.archive-year-toggle {
		min-height: 3.6rem;
		padding: 0.4rem 0.65rem;
		color: var(--text-secondary);
		cursor: pointer;
		text-align: left;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.archive-year-toggle:hover,
	.archive-year-toggle:focus-visible {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.archive-year-toggle:focus-visible,
	.archive-post:focus-visible {
		box-shadow: inset 0 0 0 2px var(--primary);
	}

	.archive-year {
		color: var(--text-primary);
		font-size: 1.45rem;
		font-weight: 780;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.035em;
		text-align: right;
	}

	.archive-year-marker {
		height: 0.7rem;
		width: 0.7rem;
		justify-self: center;
		border: 2px solid var(--primary);
		border-radius: 999px;
		background: var(--card-bg);
	}

	.archive-year-summary {
		display: flex;
		gap: 0.35rem;
		font-size: 0.84rem;
	}

	.archive-arrow {
		justify-self: center;
		font-size: 1.35rem;
	}

	.archive-year-content {
		overflow: clip;
	}

	.archive-post {
		min-height: 3.65rem;
		padding: 0.4rem 0.65rem;
		color: var(--text-secondary);
		transition: background-color 180ms ease, color 180ms ease;
	}

	.archive-post:hover,
	.archive-post:focus-visible {
		background: color-mix(in oklab, var(--primary) 7%, transparent);
		color: var(--primary);
	}

	.archive-post time {
		color: var(--text-tertiary);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.archive-post-marker {
		position: relative;
		height: 0.38rem;
		width: 0.38rem;
		justify-self: center;
		border-radius: 999px;
		background: color-mix(in oklab, var(--primary) 55%, var(--text-tertiary));
	}

	.archive-post-marker::before {
		position: absolute;
		top: -2rem;
		left: 50%;
		height: 4rem;
		width: 1px;
		background: color-mix(in oklab, var(--primary) 24%, var(--line-divider));
		content: "";
		transform: translateX(-50%);
		z-index: -1;
	}

	.archive-post-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.18rem;
	}

	.archive-post-title {
		overflow: hidden;
		color: var(--text-primary);
		font-size: 0.94rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.archive-post-meta {
		display: flex;
		overflow: hidden;
		gap: 0.45rem;
		color: var(--text-tertiary);
		font-size: 0.72rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.archive-post-chevron {
		justify-self: center;
		color: var(--text-tertiary);
		font-size: 1.2rem;
	}

	@media (max-width: 639px) {
		archive-panel {
			padding: 1rem 0.75rem 1.25rem;
		}

		.archive-filter-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.archive-year-toggle,
		.archive-post {
			grid-template-columns: 3.65rem 1.1rem minmax(0, 1fr) 1.25rem;
			gap: 0.4rem;
			padding-inline: 0.35rem;
		}

		.archive-year {
			font-size: 1.2rem;
		}

		.archive-post-meta {
			max-width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.archive-year-toggle,
		.archive-post {
			transition: none;
		}
	}
</style>

<script is:inline define:vars={{ i18nStrings, tagsBaseUrl, categoriesBaseUrl }}>
  class ArchivePanel extends HTMLElement {
    constructor() {
      super();
      // 避免 swup 重复初始化
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";
      this.init();
    }

    init() {
      const params = new URLSearchParams(window.location.search);
      const tags = params.has("tag") ? params.getAll("tag") : [];
      const categories = params.has("category") ? params.getAll("category") : [];
      const uncategorized = params.get("uncategorized");

      const hasFilter = tags.length > 0 || categories.length > 0 || !!uncategorized;

      if (hasFilter) {
        this.applyFilter(tags, categories, !!uncategorized);
        this.updateBannerTitle(tags, categories, !!uncategorized);
      }

      this.bindYearToggles();
    }

    // 按筛选条件隐藏不匹配的文章行，重算每年计数，隐藏空年份，重新折叠
    applyFilter(tags, categories, uncategorized) {
      const foldOnFilter = this.dataset.fold === "true";
      const blocks = Array.from(this.querySelectorAll(".archive-year-block"));
      let totalVisible = 0;
      const visibleBlocks = [];

      for (const block of blocks) {
        const rows = Array.from(block.querySelectorAll(".archive-post"));
        let visibleCount = 0;

        for (const row of rows) {
          let rowTags = [];
          try {
            rowTags = JSON.parse(row.dataset.tags || "[]");
          } catch {
            rowTags = [];
          }
          const rowCategory = row.dataset.category || "";

          let match = true;
          if (tags.length > 0) {
            match = match && rowTags.some((t) => tags.includes(t));
          }
          if (categories.length > 0) {
            match = match && !!rowCategory && categories.includes(rowCategory);
          }
          if (uncategorized) {
            match = match && !rowCategory;
          }

          row.hidden = !match;
          if (match) visibleCount++;
        }

        // 更新每年计数显示
        const countEl = block.querySelector(".archive-year-count");
        const labelEl = block.querySelector(".archive-year-count-label");
        if (countEl) countEl.textContent = String(visibleCount);
        if (labelEl) {
          labelEl.textContent =
            visibleCount === 1 ? i18nStrings.postCount : i18nStrings.postsCount;
        }

        // 隐藏没有可见文章的年份块
        block.hidden = visibleCount === 0;
        if (visibleCount > 0) {
          visibleBlocks.push(block);
          totalVisible += visibleCount;
        }
      }

      // 重新应用折叠：首个可见年份展开，其余折叠
      visibleBlocks.forEach((block, index) => {
        const shouldCollapse = foldOnFilter && index > 0;
        this.setBlockCollapsed(block, shouldCollapse);
      });

      // 填充并显示筛选头部
      this.renderFilterHeader(tags, categories, uncategorized, totalVisible);

	  const emptyState = this.querySelector("#archive-filter-empty");
	  if (emptyState) emptyState.hidden = totalVisible !== 0;
    }

    setBlockCollapsed(block, collapsed) {
      const content = block.querySelector(".archive-year-content");
      const toggle = block.querySelector(".archive-year-toggle");
      const arrow = block.querySelector(".archive-arrow");
      if (content) content.hidden = collapsed;
      if (toggle) toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      if (arrow) {
        arrow.style.transform = collapsed ? "rotate(-90deg)" : "";
      }
    }

    renderFilterHeader(tags, categories, uncategorized, count) {
      const header = this.querySelector("#archive-filter-header");
      if (!header) return;

      // 构造筛选项（tag 优先作为主筛选，镜像原逻辑）
      const filters = [];
      if (categories.length > 0)
        filters.push({ label: i18nStrings.categories, values: categories, isTag: false });
      if (uncategorized)
        filters.push({ label: i18nStrings.categories, values: [i18nStrings.uncategorized], isTag: false });
      if (tags.length > 0)
        filters.push({ label: i18nStrings.tags, values: tags, isTag: true });

      const primary =
        filters.find((f) => f.isTag) || filters[0] || null;
      if (!primary) return;
      const secondary = filters.filter((f) => f !== primary);

      const linkEl = header.querySelector("#archive-filter-link");
      const valuesEl = header.querySelector("#archive-filter-values");
      const secondaryEl = header.querySelector("#archive-filter-secondary");
      const countEl = header.querySelector("#archive-filter-count");
      const countLabelEl = header.querySelector("#archive-filter-count-label");

      const fmtValues = (f) => {
        const prefix = f.isTag ? "#" : "";
        return f.values.map((v) => `${prefix}${v}`).join(" / ");
      };

      if (linkEl) {
        linkEl.textContent = primary.label;
        linkEl.setAttribute("href", primary.isTag ? tagsBaseUrl : categoriesBaseUrl);
      }
      if (valuesEl) valuesEl.textContent = fmtValues(primary);
      if (secondaryEl) {
        if (secondary.length > 0) {
          const summary = secondary
            .map((f) => `${f.label}: ${fmtValues(f)}`)
            .join("  ·  ");
          secondaryEl.textContent = `· ${summary}`;
          secondaryEl.hidden = false;
        } else {
          secondaryEl.hidden = true;
        }
      }
      if (countEl) countEl.textContent = String(count);
      if (countLabelEl) {
        countLabelEl.textContent =
          count === 1 ? i18nStrings.postCount : i18nStrings.postsCount;
      }

      header.hidden = false;
    }

    updateBannerTitle(tags, categories, uncategorized) {
      const bannerTitle = document.querySelector(".banner-page-title-text");
      if (!bannerTitle) return;

      let newTitle = "";
      if (categories.length > 0) {
        newTitle = categories.join(" / ");
      } else if (uncategorized) {
        newTitle = i18nStrings.uncategorized;
      } else if (tags.length > 0) {
        newTitle = tags.map((t) => `#${t}`).join(" / ");
      }
      // 直接设置（自定义元素在解析阶段升级、首帧前执行），避免默认标题闪烁
      if (newTitle && bannerTitle.textContent !== newTitle) {
        bannerTitle.textContent = newTitle;
      }
    }

    bindYearToggles() {
      const blocks = Array.from(this.querySelectorAll(".archive-year-block"));
      for (const block of blocks) {
        const toggle = block.querySelector(".archive-year-toggle");
        const content = block.querySelector(".archive-year-content");
        const arrow = block.querySelector(".archive-arrow");
        if (!toggle || !content) continue;

        toggle.addEventListener("click", () => {
          const willCollapse = !content.hidden;
          content.hidden = willCollapse;
          toggle.setAttribute("aria-expanded", willCollapse ? "false" : "true");

          // 用 Web Animations API 做旋转动画，绕开 Swup 对 CSS transition 的干扰
          if (arrow) {
            requestAnimationFrame(() => {
              const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
              const targetTransform = willCollapse ? "rotate(-90deg)" : "rotate(0deg)";
              const animation = arrow.animate(
                [
                  { transform: willCollapse ? "rotate(0deg)" : "rotate(-90deg)" },
                  { transform: targetTransform },
                ],
                { duration: reduceMotion ? 1 : 180, easing: "ease-out" },
              );
              animation.addEventListener("finish", () => {
                arrow.style.transform = targetTransform;
              }, { once: true });
            });
          }
        });
      }
    }
  }

  if (!customElements.get("archive-panel")) {
    customElements.define("archive-panel", ArchivePanel);
  }
</script>
