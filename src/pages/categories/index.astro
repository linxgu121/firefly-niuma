---
import UtilityEmptyState from "@components/pages/UtilityEmptyState.astro";
import UtilityPageHeader from "@components/pages/UtilityPageHeader.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
const title = i18n(I18nKey.categories);
const description = i18n(I18nKey.allCategories);
---

<MainGridLayout title={title} description={description} hasVisibleH1>
	<div class="utility-page">
		<UtilityPageHeader
			title={title}
			description={description}
			icon="material-symbols:folder-open"
			stats={[
				{ label: i18n(I18nKey.categories), value: categories.length },
				{ label: i18n(I18nKey.postsCount), value: totalPosts },
			]}
		/>

		<section class="utility-panel card-base onload-animation" aria-label={description}>
			{
				categories.length > 0 ? (
					<div class="utility-link-list">
						{categories.map((category) => (
							<a href={category.url} class="utility-link-row">
								<span class="utility-link-icon" aria-hidden="true">
									<Icon is:inline name="material-symbols:folder-open" />
								</span>
								<span class="utility-link-copy">
									<span class="utility-link-title" title={category.name}>{category.name}</span>
									<span class="utility-link-meta">{category.count} {i18n(category.count === 1 ? I18nKey.postCount : I18nKey.postsCount)}</span>
								</span>
								<span class="utility-link-count">{category.count} {i18n(category.count === 1 ? I18nKey.postCount : I18nKey.postsCount)}</span>
								<Icon is:inline name="material-symbols:chevron-right-rounded" class="utility-link-chevron" />
							</a>
						))}
					</div>
				) : (
					<UtilityEmptyState message={i18n(I18nKey.noData)} icon="material-symbols:folder-off" />
				)
			}
		</section>
	</div>
</MainGridLayout>
