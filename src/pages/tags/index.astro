---
import UtilityEmptyState from "@components/pages/UtilityEmptyState.astro";
import UtilityPageHeader from "@components/pages/UtilityPageHeader.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPostsList, getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();
const posts = await getSortedPostsList();
const title = i18n(I18nKey.tags);
const description = i18n(I18nKey.allTags);
---

<MainGridLayout title={title} description={description} hasVisibleH1>
	<div class="utility-page">
		<UtilityPageHeader
			title={title}
			description={description}
			icon="material-symbols:tag-rounded"
			stats={[
				{ label: i18n(I18nKey.tagsCount), value: tags.length },
				{ label: i18n(I18nKey.postsCount), value: posts.length },
			]}
		/>

		<section class="utility-panel card-base onload-animation" aria-label={description}>
			{
				tags.length > 0 ? (
					<div class="utility-tag-cloud">
						{tags.map((tag) => (
							<a href={getTagUrl(tag.name)} class="utility-tag" aria-label={`${tag.name}, ${tag.count} ${i18n(tag.count === 1 ? I18nKey.postCount : I18nKey.postsCount)}`}>
								<span>#{tag.name.trim()}</span>
								<span class="utility-tag-count" aria-hidden="true">{tag.count}</span>
							</a>
						))}
					</div>
				) : (
					<UtilityEmptyState message={i18n(I18nKey.noData)} icon="material-symbols:tag-rounded" />
				)
			}
		</section>
	</div>
</MainGridLayout>
