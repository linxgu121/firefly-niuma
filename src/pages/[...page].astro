---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/common/Pagination.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomePosts from "@/components/home/HomePosts.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import { homePageConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getCategoryList,
	getHomePosts,
	getTagList,
} from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

export const getStaticPaths = (async () => {
	const pageSize = siteConfig.pagination.postsPerPage;
	const pinnedLimit = homePageConfig.pinned.limit;
	const firstPage = await getHomePosts(1, pageSize, pinnedLimit);

	return Promise.all(
		Array.from(
			{ length: firstPage.pagination.totalPages },
			async (_, index) => {
				const pageNumber = index + 1;
				const homeData =
					pageNumber === 1
						? firstPage
						: await getHomePosts(pageNumber, pageSize, pinnedLimit);
				return {
					params: { page: pageNumber === 1 ? undefined : String(pageNumber) },
					props: { homeData },
				};
			},
		),
	);
}) satisfies GetStaticPaths;

const { homeData } = Astro.props;
const { pinned, recent, pagination } = homeData;
const [categories, tags] = await Promise.all([getCategoryList(), getTagList()]);

const pagePath = (pageNumber: number) =>
	pageNumber === 1 ? url("/") : url(`/${pageNumber}/`);
const recentPage = {
	data: recent,
	start: (pagination.page - 1) * pagination.pageSize,
	end: (pagination.page - 1) * pagination.pageSize + recent.length - 1,
	size: pagination.pageSize,
	total: pagination.totalRecent,
	currentPage: pagination.page,
	lastPage: pagination.totalPages,
	url: {
		current: pagePath(pagination.page),
		prev: pagination.hasPrevious ? pagePath(pagination.page - 1) : undefined,
		next: pagination.hasNext ? pagePath(pagination.page + 1) : undefined,
		first: pagePath(1),
		last: pagePath(pagination.totalPages),
	},
} as Page<CollectionEntry<"posts">>;
---

<MainGridLayout>
  {pagination.page === 1 && homePageConfig.hero.enable && (
    <div class="mb-4">
      <HomeHero
        posts={pagination.totalPosts}
        categories={categories.length}
        tags={tags.length}
      />
    </div>
  )}

  {siteConfig.categoryBar && (
    <div id="category-bar-wrapper" class="mb-4 onload-animation">
      <CategoryBar />
    </div>
  )}

  <HomePosts
    pinned={pinned}
    recent={recent}
    currentPage={pagination.page}
    totalPosts={pagination.totalPosts}
    totalPinned={pagination.totalPinned}
    totalRecent={pagination.totalRecent}
  />

  {pagination.totalRecent > pagination.pageSize && (
    <Pagination
      class="mx-auto mt-5 onload-animation"
      page={recentPage}
      style={`animation-delay: calc(var(--content-delay) + ${recent.length * 50}ms)`}
    />
  )}
</MainGridLayout>
