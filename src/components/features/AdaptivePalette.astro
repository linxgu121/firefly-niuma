---
import { backgroundWallpaper } from "@/config";

const palette = backgroundWallpaper.adaptivePalette;
const enabled = palette?.enabled ?? false;
const fallbackHue = palette?.fallbackHue ?? 165;
const sampleSize = Math.min(64, Math.max(12, palette?.sampleSize ?? 32));
const cache = palette?.cache ?? "session";
const transitionMs = Math.max(0, palette?.transitionMs ?? 320);
const respectManualHue = palette?.respectManualHue ?? true;
---

{enabled && (
  <div
    id="adaptive-palette-config"
    hidden
    data-fallback-hue={fallbackHue}
    data-sample-size={sampleSize}
    data-cache={cache}
    data-transition-ms={transitionMs}
    data-respect-manual-hue={String(respectManualHue)}
  />
)}

{enabled && (
<script>
  type PaletteCache = {
    hue: number;
    luminance: number;
  };

  type AdaptiveWindow = Window & {
    __fireflyAdaptivePaletteCleanup?: () => void;
  };

  const appWindow = window as AdaptiveWindow;
  appWindow.__fireflyAdaptivePaletteCleanup?.();

  const configElement = document.getElementById(
    "adaptive-palette-config",
  ) as HTMLElement | null;
  const root = document.documentElement;
  const fallbackHue = Number(configElement?.dataset.fallbackHue ?? 165);
  const sampleSize = Number(configElement?.dataset.sampleSize ?? 32);
  const cacheMode = configElement?.dataset.cache ?? "session";
  const transitionMs = Number(configElement?.dataset.transitionMs ?? 320);
  const respectManualHue =
    configElement?.dataset.respectManualHue !== "false";
  const mobileQuery = window.matchMedia("(max-width: 1023px)");
  const cleanupTasks: Array<() => void> = [];
  let activeHue = fallbackHue;
  let scheduledFrame = 0;
  let samplingSequence = 0;

  function safeStoredValue(key: string, useSession = false): string | null {
    try {
      return (useSession ? sessionStorage : localStorage).getItem(key);
    } catch {
      return null;
    }
  }

  function safeSetStoredValue(
    key: string,
    value: string,
    useSession = false,
  ): void {
    try {
      (useSession ? sessionStorage : localStorage).setItem(key, value);
    } catch {
      // Storage can be unavailable in strict privacy modes. Palette remains in memory.
    }
  }

  function normalizeHue(value: number): number {
    if (!Number.isFinite(value)) return fallbackHue;
    return Math.round(((value % 360) + 360) % 360);
  }

  function manualHue(): number | null {
    if (!respectManualHue) return null;
    const stored = safeStoredValue("hue");
    if (stored === null || stored.trim() === "") return null;
    const parsed = Number(stored);
    return Number.isFinite(parsed) ? normalizeHue(parsed) : null;
  }

  function updateThemeColor(hue: number): void {
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (!meta) return;
    const isDark = root.classList.contains("dark");
    meta.content = isDark
      ? `hsl(${hue} 24% 13%)`
      : `hsl(${hue} 24% 94%)`;
  }

  function applyPalette(
    palette: PaletteCache,
    source: "wallpaper" | "cache" | "fallback" | "manual",
  ): void {
    const hue = normalizeHue(palette.hue);
    const luminance = Math.min(1, Math.max(0, palette.luminance));
    const useDarkForeground = luminance > 0.62;
    activeHue = hue;
    root.style.setProperty("--hue", String(hue));
    root.style.setProperty("--wallpaper-luma", luminance.toFixed(3));
    root.style.setProperty(
      "--wallpaper-foreground",
      useDarkForeground
        ? `oklch(0.22 0.018 ${hue})`
        : `oklch(0.97 0.012 ${hue})`,
    );
    root.style.setProperty(
      "--wallpaper-foreground-muted",
      useDarkForeground
        ? `oklch(0.22 0.018 ${hue} / 0.76)`
        : `oklch(0.97 0.012 ${hue} / 0.78)`,
    );
    root.style.setProperty(
      "--wallpaper-text-shadow",
      useDarkForeground
        ? "0 2px 18px rgb(255 255 255 / 0.28)"
        : "0 2px 20px rgb(4 12 13 / 0.44)",
    );
    root.style.setProperty(
      "--palette-transition-duration",
      `${transitionMs}ms`,
    );
    root.dataset.adaptivePalette = source;
    updateThemeColor(hue);
    window.dispatchEvent(
      new CustomEvent("adaptivePaletteChange", {
        detail: { hue, luminance, source },
      }),
    );
  }

  function cacheStorage(): Storage | null {
    try {
      if (cacheMode === "session") return sessionStorage;
      if (cacheMode === "local") return localStorage;
    } catch {
      return null;
    }
    return null;
  }

  function cacheKey(image: HTMLImageElement): string {
    return `firefly:adaptive-palette:v1:${mobileQuery.matches ? "mobile" : "desktop"}:${image.currentSrc || image.src}`;
  }

  function readCache(image: HTMLImageElement): PaletteCache | null {
    const storage = cacheStorage();
    if (!storage) return null;
    try {
      const parsed = JSON.parse(storage.getItem(cacheKey(image)) || "null") as
        | PaletteCache
        | null;
      return parsed && Number.isFinite(parsed.hue) && Number.isFinite(parsed.luminance)
        ? parsed
        : null;
    } catch {
      return null;
    }
  }

  function writeCache(image: HTMLImageElement, palette: PaletteCache): void {
    if (cacheMode === "none") return;
    safeSetStoredValue(
      cacheKey(image),
      JSON.stringify(palette),
      cacheMode === "session",
    );
  }

  function visibleWallpaperImage(): HTMLImageElement | null {
    const wrapper = document.getElementById("wallpaper-wrapper");
    if (!wrapper || getComputedStyle(wrapper).display === "none") return null;
    const images = Array.from(wrapper.querySelectorAll<HTMLImageElement>("img"));
    const visible = images.filter((image) => {
      const rect = image.getBoundingClientRect();
      const style = getComputedStyle(image);
      return (
        rect.width > 1 &&
        rect.height > 1 &&
        style.display !== "none" &&
        style.visibility !== "hidden" &&
        Number(style.opacity || 1) > 0
      );
    });
    return (
      visible.find((image) => image.closest(".slide-item.active")) ??
      visible.sort((a, b) => {
        const aRect = a.getBoundingClientRect();
        const bRect = b.getBoundingClientRect();
        return bRect.width * bRect.height - aRect.width * aRect.height;
      })[0] ??
      null
    );
  }

  function positionFactor(value: string | undefined, axis: "x" | "y"): number {
    if (!value) return 0.5;
    const normalized = value.toLowerCase();
    if (normalized.endsWith("%")) {
      const percent = Number.parseFloat(normalized);
      return Number.isFinite(percent) ? Math.min(1, Math.max(0, percent / 100)) : 0.5;
    }
    if (normalized === "left" || normalized === "top") return 0;
    if (normalized === "right" || normalized === "bottom") return 1;
    if (normalized === "center") return 0.5;
    return axis === "x" ? 0.5 : 0.5;
  }

  function objectPosition(image: HTMLImageElement): [number, number] {
    const tokens = getComputedStyle(image).objectPosition.trim().split(/\s+/);
    if (tokens.length === 1) {
      const token = tokens[0];
      if (token === "top" || token === "bottom") {
        return [0.5, positionFactor(token, "y")];
      }
      return [positionFactor(token, "x"), 0.5];
    }
    return [positionFactor(tokens[0], "x"), positionFactor(tokens[1], "y")];
  }

  function srgbChannel(value: number): number {
    const channel = value / 255;
    return channel <= 0.04045
      ? channel / 12.92
      : ((channel + 0.055) / 1.055) ** 2.4;
  }

  function rgbToHueAndSaturation(
    red: number,
    green: number,
    blue: number,
  ): [number, number] {
    const r = red / 255;
    const g = green / 255;
    const b = blue / 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const delta = max - min;
    const lightness = (max + min) / 2;
    if (delta < 0.012) return [fallbackHue, 0];
    const saturation = delta / (1 - Math.abs(2 * lightness - 1));
    let hue = 0;
    if (max === r) hue = 60 * (((g - b) / delta) % 6);
    else if (max === g) hue = 60 * ((b - r) / delta + 2);
    else hue = 60 * ((r - g) / delta + 4);
    return [normalizeHue(hue), saturation];
  }

  function sampleImage(image: HTMLImageElement): PaletteCache {
    const rect = image.getBoundingClientRect();
    const naturalWidth = image.naturalWidth;
    const naturalHeight = image.naturalHeight;
    if (!naturalWidth || !naturalHeight || !rect.width || !rect.height) {
      throw new Error("Wallpaper has no measurable dimensions");
    }

    const scale = Math.max(rect.width / naturalWidth, rect.height / naturalHeight);
    const renderedWidth = naturalWidth * scale;
    const renderedHeight = naturalHeight * scale;
    const [positionX, positionY] = objectPosition(image);
    const sourceX = Math.max(0, ((renderedWidth - rect.width) * positionX) / scale);
    const sourceY = Math.max(0, ((renderedHeight - rect.height) * positionY) / scale);
    const sourceWidth = Math.min(naturalWidth - sourceX, rect.width / scale);
    const sourceHeight = Math.min(naturalHeight - sourceY, rect.height / scale);

    const canvas = document.createElement("canvas");
    canvas.width = sampleSize;
    canvas.height = sampleSize;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) throw new Error("Canvas is unavailable");
    context.drawImage(
      image,
      sourceX,
      sourceY,
      sourceWidth,
      sourceHeight,
      0,
      0,
      sampleSize,
      sampleSize,
    );
    const pixels = context.getImageData(0, 0, sampleSize, sampleSize).data;
    let hueX = 0;
    let hueY = 0;
    let hueWeight = 0;
    let luminanceTotal = 0;
    let luminanceWeight = 0;

    for (let y = 0; y < sampleSize; y += 1) {
      for (let x = 0; x < sampleSize; x += 1) {
        const index = (y * sampleSize + x) * 4;
        if (pixels[index + 3] < 180) continue;
        const red = pixels[index];
        const green = pixels[index + 1];
        const blue = pixels[index + 2];
        const luminance =
          0.2126 * srgbChannel(red) +
          0.7152 * srgbChannel(green) +
          0.0722 * srgbChannel(blue);
        const distanceX = Math.abs((x + 0.5) / sampleSize - 0.5) * 2;
        const distanceY = Math.abs((y + 0.5) / sampleSize - 0.5) * 2;
        const centerWeight = 1 - Math.min(1, Math.hypot(distanceX, distanceY) / 1.42);
        const pixelWeight = 0.58 + centerWeight * 0.42;
        luminanceTotal += luminance * pixelWeight;
        luminanceWeight += pixelWeight;

        const [hue, saturation] = rgbToHueAndSaturation(red, green, blue);
        if (saturation < 0.08 || luminance < 0.025 || luminance > 0.97) continue;
        const weight = saturation ** 1.25 * pixelWeight;
        const radians = (hue * Math.PI) / 180;
        hueX += Math.cos(radians) * weight;
        hueY += Math.sin(radians) * weight;
        hueWeight += weight;
      }
    }

    const luminance = luminanceWeight > 0 ? luminanceTotal / luminanceWeight : 0.5;
    const hue =
      hueWeight > sampleSize * sampleSize * 0.025
        ? normalizeHue((Math.atan2(hueY, hueX) * 180) / Math.PI)
        : fallbackHue;
    return { hue, luminance };
  }

  async function sampleVisibleWallpaper(): Promise<void> {
    const sequence = ++samplingSequence;
    const manual = manualHue();
    if (manual !== null) {
      applyPalette({ hue: manual, luminance: 0.45 }, "manual");
      return;
    }

    const image = visibleWallpaperImage();
    if (!image) {
      applyPalette({ hue: fallbackHue, luminance: 0.45 }, "fallback");
      return;
    }

    const cached = readCache(image);
    if (cached) applyPalette(cached, "cache");

    try {
      if (!image.complete || !image.naturalWidth) {
        await new Promise<void>((resolve, reject) => {
          image.addEventListener("load", () => resolve(), { once: true });
          image.addEventListener("error", () => reject(new Error("Wallpaper failed to load")), {
            once: true,
          });
        });
      }
      if (sequence !== samplingSequence) return;
      const palette = sampleImage(image);
      writeCache(image, palette);
      applyPalette(palette, "wallpaper");
    } catch {
      if (!cached && sequence === samplingSequence) {
        applyPalette({ hue: fallbackHue, luminance: 0.45 }, "fallback");
      }
    }
  }

  function scheduleSample(): void {
    cancelAnimationFrame(scheduledFrame);
    scheduledFrame = requestAnimationFrame(() => {
      void sampleVisibleWallpaper();
    });
  }

  applyPalette(
    { hue: manualHue() ?? fallbackHue, luminance: 0.45 },
    manualHue() === null ? "fallback" : "manual",
  );
  scheduleSample();

  const wrapper = document.getElementById("wallpaper-wrapper");
  if (wrapper) {
    const observer = new MutationObserver(scheduleSample);
    observer.observe(wrapper, {
      attributes: true,
      attributeFilter: ["class", "src", "srcset", "style"],
      childList: true,
      subtree: true,
    });
    cleanupTasks.push(() => observer.disconnect());
  }

  const themeObserver = new MutationObserver(() => {
    const inlineHue = Number(root.style.getPropertyValue("--hue"));
    if (Number.isFinite(inlineHue)) activeHue = normalizeHue(inlineHue);
    updateThemeColor(activeHue);
  });
  themeObserver.observe(root, {
    attributes: true,
    attributeFilter: ["class", "style"],
  });
  cleanupTasks.push(() => themeObserver.disconnect());

  const onWallpaperChange = () => scheduleSample();
  const onThemeChange = () => updateThemeColor(activeHue);
  const onHueChange = () => scheduleSample();
  const onStorage = (event: StorageEvent) => {
    if (event.key === "hue") scheduleSample();
  };
  window.addEventListener("wallpaperModeChange", onWallpaperChange);
  window.addEventListener("bannerCarouselChange", onWallpaperChange);
  window.addEventListener("theme-change", onThemeChange);
  window.addEventListener("hue-change", onHueChange);
  window.addEventListener("storage", onStorage);
  mobileQuery.addEventListener("change", onWallpaperChange);
  cleanupTasks.push(() => {
    window.removeEventListener("wallpaperModeChange", onWallpaperChange);
    window.removeEventListener("bannerCarouselChange", onWallpaperChange);
    window.removeEventListener("theme-change", onThemeChange);
    window.removeEventListener("hue-change", onHueChange);
    window.removeEventListener("storage", onStorage);
    mobileQuery.removeEventListener("change", onWallpaperChange);
  });

  appWindow.__fireflyAdaptivePaletteCleanup = () => {
    cancelAnimationFrame(scheduledFrame);
    samplingSequence += 1;
    cleanupTasks.forEach((cleanup) => cleanup());
  };
</script>
)}
