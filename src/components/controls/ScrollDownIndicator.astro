---
import { Icon } from "astro-icon/components";
---

<div
  id="scroll-down-indicator"
  class="scroll-down-indicator"
  onclick="document.getElementById('main-grid')?.scrollIntoView({ behavior: 'smooth' })"
>
  <Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="scroll-down-icon" />
</div>

<script is:inline>
  (function () {
    // 防止重复初始化（Swup 页面切换时可能重复执行）
    if (window.__scrollDownIndicatorInit) return;
    window.__scrollDownIndicatorInit = true;

    var sentinel = document.getElementById("scroll-visibility-sentinel");
    if (!sentinel) {
      sentinel = document.createElement("span");
      sentinel.id = "scroll-visibility-sentinel";
      sentinel.setAttribute("aria-hidden", "true");
      sentinel.style.cssText = "position:absolute;top:100px;left:0;width:1px;height:1px;pointer-events:none;";
      document.body.prepend(sentinel);
    }

    var observer = new IntersectionObserver(function (entries) {
      var indicator = document.getElementById("scroll-down-indicator");
      if (!indicator) return;
      indicator.classList.toggle("hide", !entries[0].isIntersecting);
    });
    observer.observe(sentinel);
  })();
</script>
