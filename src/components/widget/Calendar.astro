---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const configuredMaxSelectedPosts =
	widgetConfig?.specificConfig?.calendar?.maxSelectedPosts ?? 5;
const maxSelectedPosts = Number.isFinite(configuredMaxSelectedPosts)
	? Math.min(5, Math.max(1, Math.trunc(configuredMaxSelectedPosts)))
	: 5;

// 标题由组件内部自定义渲染（图标 + 发文日历 + 年份），不走 WidgetLayout 默认标题
const showTitle = false;

// 星期表头取首字（中文即"日一二三四五六"，英文取首字母）
const weekDays = [
	i18n(I18nKey.calendarSunday),
	i18n(I18nKey.calendarMonday),
	i18n(I18nKey.calendarTuesday),
	i18n(I18nKey.calendarWednesday),
	i18n(I18nKey.calendarThursday),
	i18n(I18nKey.calendarFriday),
	i18n(I18nKey.calendarSaturday),
].map((d) => d.charAt(0));

const calendarDataUrl = url("/api/allPostMeta.json");
const postUrlPrefix = url("/posts/");
---

<WidgetLayout
  name={i18n(I18nKey.calendar)}
  showTitle={showTitle}
  id="calendar-widget"
  class={className}
  style={style}
>
  <div class="post-calendar">
    {/* 头部：图标 + 标题 + 年份 */}
    <div class="flex items-center justify-between mb-1.5">
      <div class="flex items-center gap-1.5">
        <div class="text-(--primary) text-base">
          <Icon is:inline name="material-symbols:calendar-month-outline-rounded" />
        </div>
        <span class="font-bold text-xs text-neutral-800 dark:text-neutral-100">
          发文日历
        </span>
      </div>
      <span class="text-xs font-bold text-(--primary)" id="cal-year"></span>
    </div>

    {/* 月份标签 */}
    <div
      class="text-[10px] text-neutral-500 dark:text-neutral-400 mb-1 font-medium"
      id="cal-month-label"
    >
    </div>

    {/* 星期表头 */}
    <div class="grid grid-cols-7 gap-0.5 mb-0.5">
      {
        weekDays.map((day) => (
          <span class="text-center text-[10px] text-neutral-500 dark:text-neutral-400 font-medium leading-4">
            {day}
          </span>
        ))
      }
    </div>

    {/* 日期格（客户端渲染当前月） */}
    <div class="grid grid-cols-7 gap-0.5" id="cal-day-grid"></div>

    <p class="mt-1.5 text-[10px] leading-4 text-neutral-500 dark:text-neutral-400">
      点击带圆点的日期可多选
    </p>

    {/* 多日期文章列表 */}
    <div id="calendar-posts" class="hidden mt-3">
      <div class="border-t border-neutral-200 dark:border-neutral-700 mb-2"></div>
      <div class="mb-1.5 flex items-start justify-between gap-2">
        <span
          id="calendar-posts-summary"
          class="min-w-0 text-[10px] leading-4 text-neutral-500 dark:text-neutral-400"
          aria-live="polite"
        ></span>
        <button
          id="calendar-posts-clear"
          type="button"
          class="shrink-0 rounded-md px-1 py-0.5 text-[10px] text-(--primary) transition-colors hover:bg-(--btn-plain-bg-hover) focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-(--primary)"
        >
          清除
        </button>
      </div>
      <div
        class="flex flex-col gap-1 max-h-44 overflow-y-auto custom-scrollbar"
        id="calendar-posts-list"
      >
      </div>
    </div>
  </div>
</WidgetLayout>

<script
  is:inline
  data-swup-ignore-script
  define:vars={{ calendarDataUrl, postUrlPrefix, maxSelectedPosts }}
>
  function initPostCalendar() {
    const yearEl = document.getElementById("cal-year");
    const monthEl = document.getElementById("cal-month-label");
    const gridEl = document.getElementById("cal-day-grid");
    if (!gridEl) return;

    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth(); // 0-11

    if (yearEl) yearEl.textContent = year;
    if (monthEl) monthEl.textContent = `${month + 1}月`;

    fetch(calendarDataUrl)
      .then((r) => r.json())
      .then((posts) => {
        if (!Array.isArray(posts)) throw new Error("文章日历数据格式无效");

        // 按日期归组
        const postMap = {};
        posts.forEach((post) => {
          const d = new Date(post.published);
          if (d.getFullYear() !== year || d.getMonth() !== month) return;
          const key = d.getDate();
          if (!postMap[key]) postMap[key] = [];
          postMap[key].push(post);
        });

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const today = now.getDate();

        let html = "";
        for (let i = 0; i < firstDay; i++) {
          html += '<div class="day-cell"></div>';
        }
        for (let day = 1; day <= daysInMonth; day++) {
          const list = postMap[day] || [];
          const hasPosts = list.length > 0;
          const isToday = day === today;
          const cellTag = hasPosts ? "button" : "span";
          const accessibility = hasPosts
            ? `type="button" aria-pressed="false" aria-label="${month + 1}月${day}日，${list.length}篇文章"`
            : "";
          html += `
            <${cellTag}
              class="day-cell flex items-center justify-center rounded-full relative text-xs leading-none transition
                ${hasPosts ? "has-posts text-neutral-900 dark:text-neutral-100 font-bold hover:bg-(--btn-plain-bg-hover)" : "text-neutral-700 dark:text-neutral-300"}
                ${isToday ? "is-today" : ""}"
              data-day="${day}"
              data-has-posts="${hasPosts}"
              ${accessibility}
            >
              <span class="day-num">${day}</span>
              ${hasPosts ? '<span class="day-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-(--primary)"></span>' : ""}
              ${hasPosts && list.length > 1 ? `<span class="day-count absolute top-0 right-0 text-[9px] text-(--primary) font-bold leading-none">${list.length}</span>` : ""}
            </${cellTag}>
          `;
        }
        gridEl.innerHTML = html;

        // 日期可以累加选择，所有文章按发布时间从早到晚显示
        const wrapper = document.getElementById("calendar-posts");
        const listEl = document.getElementById("calendar-posts-list");
        const summaryEl = document.getElementById("calendar-posts-summary");
        const clearButton = document.getElementById("calendar-posts-clear");
        const selectedDays = new Set();

        const renderSelectedPosts = () => {
          const selectedPosts = Array.from(selectedDays)
            .flatMap((day) => postMap[day] || [])
            .sort((a, b) => Number(a.published) - Number(b.published));

          if (selectedPosts.length === 0) {
            if (wrapper) wrapper.classList.add("hidden");
            if (listEl) listEl.replaceChildren();
            if (summaryEl) summaryEl.textContent = "";
            return;
          }

          const visiblePosts = selectedPosts.slice(0, maxSelectedPosts);
          if (summaryEl) {
            summaryEl.textContent =
              selectedPosts.length > visiblePosts.length
                ? `已选 ${selectedDays.size} 天，共 ${selectedPosts.length} 篇，显示最早 ${visiblePosts.length} 篇`
                : `已选 ${selectedDays.size} 天，共 ${selectedPosts.length} 篇，从早到晚`;
          }

          if (listEl) {
            const fragment = document.createDocumentFragment();
            visiblePosts.forEach((post) => {
              const published = new Date(post.published);
              const link = document.createElement("a");
              link.href = `${postUrlPrefix}${post.id}/`;
              link.className =
                "flex items-center justify-between gap-2 rounded-md px-2 py-1 text-xs text-neutral-700 transition-colors hover:bg-(--btn-plain-bg-hover) hover:text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-(--primary) dark:text-neutral-300";

              const title = document.createElement("span");
              title.className = "min-w-0 truncate";
              title.textContent = post.title;
              title.title = post.title;

              const time = document.createElement("time");
              time.className =
                "shrink-0 whitespace-nowrap text-[10px] text-neutral-500 dark:text-neutral-400";
              time.dateTime = published.toISOString();
              const dateLabel = `${published.getMonth() + 1}-${published.getDate()}`;
              const hasExplicitTime =
                published.getUTCHours() !== 0 ||
                published.getUTCMinutes() !== 0 ||
                published.getUTCSeconds() !== 0;
              time.textContent = hasExplicitTime
                ? `${dateLabel} ${String(published.getHours()).padStart(2, "0")}:${String(published.getMinutes()).padStart(2, "0")}`
                : dateLabel;

              link.append(title, time);
              fragment.append(link);
            });
            listEl.replaceChildren(fragment);
          }
          if (wrapper) wrapper.classList.remove("hidden");
        };

        gridEl.querySelectorAll("button.day-cell[data-has-posts='true']").forEach((cell) => {
          cell.addEventListener("click", () => {
            const day = Number(cell.getAttribute("data-day"));
            if (!Number.isInteger(day)) return;
            const willSelect = !selectedDays.has(day);
            if (willSelect) selectedDays.add(day);
            else selectedDays.delete(day);
            cell.classList.toggle("calendar-day-selected", willSelect);
            cell.setAttribute("aria-pressed", String(willSelect));
            renderSelectedPosts();
          });
        });

        clearButton?.addEventListener("click", () => {
          selectedDays.clear();
          gridEl.querySelectorAll("button.calendar-day-selected").forEach((cell) => {
            cell.classList.remove("calendar-day-selected");
            cell.setAttribute("aria-pressed", "false");
          });
          renderSelectedPosts();
        });
      })
      .catch((e) => console.error("发文日历数据加载失败", e));
  }

  initPostCalendar();

  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(initPostCalendar, 100);
  });
</script>

<style>
  /* 日历卡片更紧凑的内边距（覆盖 WidgetLayout 的 px-4 pb-4） */
  :global(#calendar-widget) {
    padding-left: 0.875rem;
    padding-right: 0.875rem;
    padding-bottom: 0.75rem;
  }
  :global(#calendar-widget.collapse-wrapper) {
    padding-top: 0.75rem;
  }

  /* 日期行高度：窄栏配高行，形成细长形态 */
  :global(#calendar-widget .day-cell) {
    height: 27px;
		appearance: none;
		border: 0;
		padding: 0;
  }

  :global(#calendar-widget button.day-cell) {
		cursor: pointer;
	}

  :global(#calendar-widget button.day-cell:focus-visible) {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

  /* 今天：实心主题色圆点 */
  :global(#calendar-widget .day-cell.is-today) {
    background-color: var(--primary);
    color: white !important;
    font-weight: 600;
    box-shadow: 0 1px 3px color-mix(in oklab, var(--primary) 40%, transparent);
  }

  :global(#calendar-widget .day-cell.is-today .day-dot) {
    background-color: rgba(255, 255, 255, 0.85);
  }

  :global(#calendar-widget .day-cell.calendar-day-selected) {
		background-color: var(--btn-regular-bg);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 45%, transparent);
	}

	:global(#calendar-widget .day-cell.is-today.calendar-day-selected) {
		background-color: var(--primary);
		box-shadow:
			0 0 0 2px color-mix(in oklab, var(--primary) 30%, transparent),
			0 1px 3px color-mix(in oklab, var(--primary) 40%, transparent);
  }
</style>
